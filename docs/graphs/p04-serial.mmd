---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	order(order)
	policy(policy)
	draft(draft)
	validate(validate)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	draft --> validate;
	intake -.-> draft;
	intake -.-> order;
	order -.-> draft;
	order -.-> policy;
	policy --> draft;
	validate --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
