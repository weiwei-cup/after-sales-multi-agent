# P04 supports single and serial multi-Agent with offline scripted models.
AFTER_SALES_MODEL_MODE=scripted
AFTER_SALES_BUSINESS_DB_PATH=var/business.sqlite
AFTER_SALES_CHECKPOINT_DB_PATH=var/checkpoints.sqlite
AFTER_SALES_MAX_MODEL_CALLS=20
AFTER_SALES_MAX_TOOL_CALLS=30
AFTER_SALES_REVIEW_REPAIR_LIMIT=2
AFTER_SALES_MAX_CONCURRENCY=2
AFTER_SALES_TOKEN_BUDGET=50000
AFTER_SALES_TOOL_TIMEOUT_SECONDS=3
AFTER_SALES_TOOL_MAX_RESULT_BYTES=12000
AFTER_SALES_PROPOSAL_REPAIR_LIMIT=1
AFTER_SALES_MODEL_TIMEOUT_SECONDS=30
# User chose to defer live provider integration. These fields reserve future configuration.
# Never commit a real key; live-smoke currently reports skipped.
